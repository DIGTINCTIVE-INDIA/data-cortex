# Used only by api-tests/setup.ts (pnpm api:setup). Copy to .env and fill in.
# The script talks to a running core-server over HTTP; nothing here is read by the app itself.

TEST_API_URL=http://127.0.0.1:3000

# --- how the script signs in as an admin (sign-in is Microsoft-only, so it signs its own token) ---
# Same value as ACCESS_TOKEN_SECRET in backend/.env, plus an existing enabled admin user.
TEST_ACCESS_TOKEN_SECRET=
TEST_ADMIN_ID=
TEST_ADMIN_EMAIL=
TEST_ADMIN_NAME=
# Or paste a valid admin access token here instead of the four lines above:
TEST_ADMIN_TOKEN=

# --- Postgres: one server, a source database and a target database ---
TEST_PG_HOST=
TEST_PG_PORT=5432
TEST_PG_USER=
TEST_PG_PASSWORD=
TEST_PG_SCHEMA=public
TEST_PG_SOURCE_DB=demo_crm
TEST_PG_TARGET_DB=testing_data_cortex
TEST_PG_SOURCE_TABLE=hcp_sales
# TEST_PG_CUSTOM_SQL=SELECT * FROM hcp_sales WHERE territory = 'Central'

# --- Snowflake: same account, a source and a target location. Leave the key empty to skip Snowflake. ---
TEST_SF_ACCOUNT=
TEST_SF_USER=
TEST_SF_WAREHOUSE=
TEST_SF_ROLE=
TEST_SF_PRIVATE_KEY=
# ...or reuse connections that already exist in the app (no key needed). Snowflake is production.
TEST_SF_SOURCE_CONNECTION_ID=
TEST_SF_TARGET_CONNECTION_ID=
TEST_SF_SOURCE_DATABASE=
TEST_SF_SOURCE_SCHEMA=DATACORTEX_TESTING_CLIENT_AA
TEST_SF_TARGET_DATABASE=
TEST_SF_TARGET_SCHEMA=DATACORTEX_TESTING_CLIENT_BB
TEST_SF_SOURCE_TABLE=CUSTOMERS
# TEST_SF_CUSTOM_SQL=SELECT * FROM CUSTOMERS WHERE REGION = 'EU'

# --- S3 file source ---
TEST_S3_BUCKET=
TEST_S3_REGION=
TEST_S3_ACCESS_KEY=
TEST_S3_SECRET_KEY=
TEST_S3_FILE_PATH=Data_Cortex/
TEST_S3_FILE_NAME=hcp_sales
TEST_S3_FILE_TYPE=csv

# --- users to create (use real addresses: sign-in is Microsoft-only) ---
TEST_ENGINEER_EMAIL=
TEST_ENGINEER_NAME=Test Engineer
TEST_ANALYST_EMAIL=
TEST_ANALYST_NAME=Test Analyst

# --- fire the checks after creating them? false = create only (default). true = fire every check at once. ---
TEST_FIRE_CHECKS=false
