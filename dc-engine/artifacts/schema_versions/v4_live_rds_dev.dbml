// Source: LIVE RDS dev database (Asad's instance)
//   bct-rds-pg-data-cortex-dev-01.ccrcauo6c2q2.us-east-1.rds.amazonaws.com:5432
//   database: data_cortex_dev   schemas: dc_result,public
// Captured: 2026-10-05 by read-only introspection (information_schema + pg_catalog)
// Role in comparison: ground truth -- what is actually deployed
//
// *** DEV DATABASE -- THIS CAN CHANGE AT ANY TIME. ***
// Treat this as a point-in-time snapshot, not a stable reference. Re-pull
// before relying on it. Anyone on the team can reshape it without notice,
// and both backends have write access (data_cortex_dev is the DATABASE_URL
// target for the pipeline .env).
//
// PostgreSQL 17.9 on aarch64-unknown-linux-gnu

// ======================================================================
//  ENUM TYPES DEFINED IN THIS DATABASE
// ======================================================================

Enum check_criticality {
  "low"
  "medium"
  "high"
}

Enum check_status {
  "passed"
  "failed"
}

Enum check_type {
  "conformance"
  "custom_sql"
}

Enum database_type_enum {
  "mysql"
  "postgres"
  "snowflake"
}

Enum file_storage_type_enum {
  "aws-s3"
  "azure"
  "gcs"
  "local-storage"
}

Enum issue_status {
  "open"
  "resolved"
  "discarded"
}

Enum qc_tag_type {
  "impacted_downstream"
  "workstream"
  "data_source"
  "category"
}

Enum results_criticality {
  "low"
  "medium"
  "high"
}

Enum source_file_delimiter {
  "comma"
  "pipe"
  "tab"
  "semicolon"
}

Enum source_file_type {
  "excel"
  "csv"
  "json"
}

Enum tcd_data_type {
  "string"
  "integer"
  "float"
  "date"
  "datetime"
  "boolean"
  "varchar"
}

Enum testing_mock_status {
  "active"
  "inactive"
  "pending"
  "failed"
}

Enum user_role {
  "admin"
  "engineer"
  "analyst"
}

// ======================================================================
//  CHECK LIBRARY TABLES
// ======================================================================

Table traditional_checks_library {
  check_id varchar [pk]
  check_mapping_name varchar [unique, not null]
  check_name varchar [unique, not null]
  check_description text
  check_function varchar [not null]
  abort boolean [not null]
  user_id uuid
  enabled boolean [default: true]
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
}

Ref: users.id < traditional_checks_library.user_id  // ON DELETE SET NULL

Table traditional_checks_library_rev {
  check_id varchar(10) [pk, default: `('TC'`]
  check_mapping_name varchar(255) [unique, not null]
  check_name varchar(255) [unique, not null]
  check_description text
  abort boolean [not null]
}

// ======================================================================
//  CONNECTION TABLES
// ======================================================================

Table database_connection {
  connection_id varchar [pk]
  connection_name varchar [unique, not null]
  database_type database_type_enum [not null]
  host varchar
  port integer
  database_name varchar [not null]
  username varchar [not null]
  password varchar [not null]
  user_id uuid
  ssl boolean [not null, default: true]
  db_schema varchar [not null]
  additional_params varchar
  enabled boolean [not null, default: true]
  deactivated_at timestamp
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp
}

Ref: users.id < database_connection.user_id  // ON DELETE SET NULL

Table file_connection {
  connection_id varchar [pk]
  connection_name varchar [unique, not null]
  storage_type file_storage_type_enum [not null]
  bucket_or_container_name varchar [not null]
  region varchar [not null]
  access_key_id varchar [not null]
  secret_access_key varchar [not null]
  additional_params varchar
  user_id uuid
  enabled boolean [not null, default: true]
  deactivated_at timestamp
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp
}

Ref: users.id < file_connection.user_id  // ON DELETE SET NULL

// ======================================================================
//  CONFIG TABLES
// ======================================================================

Table db_based_checks_config {
  config_id varchar [pk]
  config_name varchar [unique, not null]
  check_category integer [not null]
  workstream integer [not null]
  impacted_downstream "int4[]" [not null]
  data_source integer [not null]
  source_connection_id varchar [not null]
  source_table_name varchar [not null]
  target_connection_id varchar [not null]
  target_table_prefix varchar [not null]
  landing_table boolean [not null, default: false]
  landing_table_name varchar
  schema_table_name varchar [not null]
  enabled boolean [not null, default: true]
  user_id uuid [not null]
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
  deactivated_at timestamp
}

Ref: qc_tags.id < db_based_checks_config.check_category
Ref: qc_tags.id < db_based_checks_config.data_source
Ref: database_connection.connection_id < db_based_checks_config.source_connection_id
Ref: database_connection.connection_id < db_based_checks_config.target_connection_id
Ref: users.id < db_based_checks_config.user_id
Ref: qc_tags.id < db_based_checks_config.workstream

Table file_based_checks_config {
  config_id varchar [pk]
  config_name varchar [unique, not null]
  check_category integer [not null]
  workstream integer [not null]
  impacted_downstream "int4[]" [not null]
  data_source integer [not null]
  source_connection_id varchar [not null]
  source_file_type source_file_type [not null, default: `'csv'`]
  source_file_name varchar [not null]
  source_file_path varchar [default: `'/'`]
  target_connection_id varchar [not null]
  target_table_prefix varchar [not null]
  landing_table boolean [not null, default: false]
  landing_table_name varchar
  schema_file_name varchar [not null, default: `''`]
  enabled boolean [not null, default: true]
  user_id uuid [not null]
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
  source_file_delimiter source_file_delimiter
  deactivated_at timestamp
}

Ref: qc_tags.id < file_based_checks_config.check_category
Ref: qc_tags.id < file_based_checks_config.data_source
Ref: file_connection.connection_id < file_based_checks_config.source_connection_id
Ref: database_connection.connection_id < file_based_checks_config.target_connection_id
Ref: users.id < file_based_checks_config.user_id
Ref: qc_tags.id < file_based_checks_config.workstream

Table custom_business_checks_config {
  check_id varchar [pk]
  check_name varchar [unique, not null]
  check_description text
  check_category integer [not null]
  workstream integer [not null]
  impacted_downstream "int4[]" [not null]
  data_source integer [not null]
  source_connection_id varchar [not null]
  target_connection_id varchar [not null]
  target_table_prefix varchar [not null]
  sql_query text [not null]
  criticality check_criticality [not null]
  error_message varchar
  enabled boolean [not null, default: true]
  user_id uuid [not null]
  updated_at timestamp [default: `now()`]
  connection_id varchar(50)
  source_or_process varchar(50)
  table_name varchar(100)
  deactivated_at timestamp
  created_at timestamp [not null, default: `now()`]
}

Ref: qc_tags.id < custom_business_checks_config.check_category
Ref: qc_tags.id < custom_business_checks_config.data_source
Ref: database_connection.connection_id < custom_business_checks_config.source_connection_id
Ref: database_connection.connection_id < custom_business_checks_config.target_connection_id
Ref: users.id < custom_business_checks_config.user_id
Ref: qc_tags.id < custom_business_checks_config.workstream

// ======================================================================
//  TRADITIONAL CONFIG DETAILS TABLE
// ======================================================================

Table traditional_config_details {
  tc_req_id integer [pk, increment]
  config_id varchar [not null]
  field varchar [not null]
  column_order integer [not null]
  column_datatype tcd_data_type [not null]
  primary_key_check boolean [not null]
  primary_key_check_criticality check_criticality
  null_check boolean [not null]
  null_check_criticality check_criticality
  duplicate_check boolean [not null]
  duplicate_check_criticality check_criticality
  length_check boolean [not null]
  expected_length integer
  length_check_criticality check_criticality
  format_check boolean [not null]
  format_regex varchar
  format_check_criticality check_criticality
  lov_check boolean [not null]
  lovs text
  lov_check_criticality check_criticality
  ri_check boolean [not null]
  ri_connection_id varchar
  ri_reference_table varchar
  ri_field_name varchar
  ri_check_criticality check_criticality
  enabled boolean [not null, default: true]
  user_id uuid [not null]
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
}

Ref: file_based_checks_config.config_id < traditional_config_details.config_id  // ON DELETE CASCADE
Ref: database_connection.connection_id < traditional_config_details.ri_connection_id
Ref: users.id < traditional_config_details.user_id

// ======================================================================
//  LABELLING/TAGGING
// ======================================================================

Table qc_tags {
  id integer [pk, increment]
  tag_type qc_tag_type [not null]
  tag_title varchar [not null]
  description text
  user_id uuid
  enabled boolean [default: true]
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
  deactivated_at timestamp
}

Ref: users.id < qc_tags.user_id  // ON DELETE SET NULL

Table category_label_library {
  category_id integer [pk, increment]
  category_name varchar(255) [not null]
  category_created_at timestamptz [default: `now()`]
  category_description text
}

Table workstream_library {
  workstream_id integer [pk, increment]
  workstream_name varchar(255) [not null]
  workstream_created_at timestamptz [default: `now()`]
  workstream_description text
}

Table impacted_downstream_library {
  impacted_downstream_id integer [pk, increment]
  impacted_downstream_name varchar(255) [not null]
  impacted_downstream_created_at timestamptz [not null, default: `now()`]
  impacted_downstream_description text
}

Table data_source_library {
  data_source_id integer [pk, increment]
  data_source_name varchar(255) [not null]
  data_source_created_at timestamptz [default: `now()`]
  data_source_description text
}

// ======================================================================
//  DATA CORTEX LOGS/RESULT
// ======================================================================

Table results {
  check_execution_id integer [pk, increment]
  job_id varchar [not null]
  job_timestamp timestamp [not null]
  check_id varchar [not null]
  check_name varchar [not null]
  check_description varchar
  config_id varchar [not null]
  config_name varchar [not null]
  check_category integer [not null]
  workstream integer [not null]
  impacted_downstream "int4[]" [not null]
  data_source integer [not null]
  file_or_table_name varchar [not null]
  check_type check_type [not null]
  field varchar [not null]
  abort boolean [not null]
  check_status check_status
  criticality results_criticality [not null]
  issue_rows varchar [not null]
  passed_rows varchar [not null]
  failure_reason varchar
  issue_status issue_status [default: `'open'`]
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
}

Ref: qc_tags.id < results.check_category
Ref: qc_tags.id < results.data_source
Ref: qc_tags.id < results.workstream

Table "dc_result.results" {
  check_execution_id bigint [pk, increment]
  job_id varchar(255) [not null]
  job_timestamp timestamp [not null]
  check_id varchar(255) [not null]
  check_name varchar(255) [not null]
  check_description text
  config_id varchar(255) [not null]
  config_name varchar(255) [not null]
  check_category varchar(255) [not null]
  workstream varchar(255) [not null]
  impacted_downstream varchar(255)
  data_source varchar(255) [not null]
  file_or_table_name varchar(255) [not null]
  check_type varchar(255) [not null]
  field varchar(255)
  abort boolean
  check_status varchar(100)
  criticality varchar(100)
  issue_rows varchar(255)
  passed_rows varchar(255)
  failure_reason text
  issue_status varchar(100)
}

Table system_logs {
  id varchar [pk]
  job_id varchar [not null]
  user_id varchar
  timestamp timestamp [not null]
  code varchar [not null]
  severity varchar [not null]
  message text [not null]
  context_json text
  flushed_at timestamp
}

Table validation_logs {
  id varchar [pk]
  job_id varchar [not null]
  user_id varchar
  timestamp timestamp [not null]
  message text [not null]
  context_json text
  flushed_at timestamp
}

// ======================================================================
//  SUPPORTING / APP-INFRA TABLES
// ======================================================================

Table users {
  id uuid [pk, default: `gen_random_uuid()`]
  email varchar(255) [unique, not null]
  full_name varchar(255) [not null]
  role user_role [not null, default: `'analyst'`]
  refresh_token text
  enabled boolean [default: true]
  created_by uuid
  last_login_at timestamp [default: `now()`]
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
  deactivated_at timestamp
}

Ref: users.id < users.created_by  // ON DELETE SET NULL

Table id_sequences {
  id uuid [pk, default: `gen_random_uuid()`]
  table_name varchar(250) [unique, not null]
  prefix varchar(10) [not null]
  value integer [not null, default: 0]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
}

Table testing_mock_records {
  mock_record_id integer [pk, increment]
  record_code varchar(32) [not null]
  customer_code varchar(32) [not null]
  full_name varchar(120) [not null]
  email varchar(160) [not null]
  status testing_mock_status [not null, default: `'active'`]
  region varchar(40) [not null]
  category varchar(40) [not null]
  amount "numeric(12,2)" [not null]
  score integer [not null]
  event_date date [not null]
  enabled boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

// ======================================================================
//  ENGINE-GENERATED OUTPUT TABLES (not schema design)
// ======================================================================
//
//  Created per check-config run by the pipeline (target_table_prefix +
//  _landing / _valid / _err). Listed by name only -- they are job output,
//  and they do not belong in any design version.
