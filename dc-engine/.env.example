AIRFLOW_UID=50000

# =============================================================================
# Airflow
# =============================================================================
# Shared Fernet key for the Airflow metadata DB (connection/variable encryption).
# Must be identical across webserver/scheduler/worker/triggerer, so it lives here
# rather than being generated per container. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=

# Airflow UI / REST API admin login (used by docker-compose's airflow-init).
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow

# =============================================================================
# Encryption
# =============================================================================
# Secret key used for AES-256-GCM encryption/decryption of sensitive data
# (e.g. external database passwords) before storing in DB.
ENCRYPTION_KEY=
ENCRYPTION_SECRET_KEY=

# =============================================================================
# JWT / Auth secrets
# =============================================================================
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=

# =============================================================================
# Snowflake
# =============================================================================
# Auth is key-pair based -- SNOWFLAKE_PRIVATE_KEY_PATH points to a .p8 private
# key file (not included in this package; keep it outside version control).
SNOWFLAKE_USER=
SNOWFLAKE_PRIVATE_KEY_PATH=
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=
SNOWFLAKE_SCHEMA=
SNOWFLAKE_ROLE=

# =============================================================================
# S3
# =============================================================================
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=

# =============================================================================
# RDS / Postgres
# =============================================================================
RDS_TYPE=postgresql
RDS_SCHEMA=public
RDS_RESULTS_SCHEMA=public
RDS_HOST=
RDS_PORT=5432
RDS_USERNAME=
RDS_PASSWORD=
RDS_DATABASE=

DATABASE_URL=postgresql+psycopg2://<user>:<password>@<host>:<port>/<database>

# =============================================================================
# Logging
# =============================================================================
config_type=source
LOG_FLUSH_INTERVAL_SECONDS=300
LOG_FLUSH_ON_END=true
DB_LOGGING_ENABLED=true
LOG_FLUSH_MODE=periodic
